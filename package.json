{
  "name": "obo-poc",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/run.mjs local",
    "start:entra": "node scripts/run.mjs entra",
    "idp": "node scripts/start-idp.mjs",
    "test:e2e": "playwright test -c playwright.config.ts",

# Profile "local": every app runs on this machine, and the IdP is NAV's mock-oauth2-server on :9000,
# configured (idp/mock-oauth2-config.json) to issue Entra v2-shaped tokens for tenant "local-tenant".
# Any value here can be overridden by a real environment variable of the same name.

IDP_KIND=mock
# Same shape as Entra's https://login.microsoftonline.com/<tenant-id>/v2.0 authority; endpoints come from
# <authority>/.well-known/openid-configuration.
IDP_AUTHORITY=http://localhost:9000/local-tenant
IDP_PORT=9000

# System One front end (SPA, public client: auth code + PKCE in the browser, no secret).
S1_WEB_BASE_URL=http://localhost:8001
S1_WEB_CLIENT_ID=system-one-web
S1_WEB_REDIRECT_URI=http://localhost:8001/
S1_WEB_SCOPES=openid profile offline_access api://system-one-api/access_as_user

# System One API (confidential client: validates the user token, then does On-Behalf-Of).
S1_API_BASE_URL=http://localhost:8011
S1_API_CLIENT_ID=system-one-api
S1_API_CLIENT_SECRET=local-s1-api-secret
S1_API_AUDIENCES=system-one-api,api://system-one-api
S1_API_REQUIRED_SCOPE=access_as_user

# System Two (embedded page + API). S1 API asks for S2_OBO_SCOPE; System Two accepts S2_AUDIENCES.
S2_BASE_URL=http://localhost:8002
S2_OBO_SCOPE=api://system-two/access_as_user
S2_AUDIENCES=system-two,api://system-two
S2_REQUIRED_SCOPE=access_as_user

# Test user for the e2e login helper. The mock accepts any username; E2E_DISPLAY_NAME becomes the "name" claim.
E2E_USERNAME=alice
E2E_DISPLAY_NAME=Alice Example

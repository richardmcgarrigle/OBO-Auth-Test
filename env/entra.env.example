# Profile "entra": the apps run locally, and the IdP is a real Microsoft Entra ID tenant.
# Copy to env/entra.env (gitignored) and fill in. Keep secrets out of the file if you prefer:
# S1_API_CLIENT_SECRET and E2E_PASSWORD can be supplied as real environment variables instead.
# Setup steps are listed in README.md ("Switching to Entra").

IDP_KIND=entra
IDP_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0

# App registration "System One Web": platform = Single-page application, redirect URI below.
# API permissions: System One API -> access_as_user (delegated).
S1_WEB_BASE_URL=http://localhost:8001
S1_WEB_CLIENT_ID=<system-one-web-client-id>
S1_WEB_REDIRECT_URI=http://localhost:8001/
S1_WEB_SCOPES=openid profile offline_access api://<system-one-api-client-id>/access_as_user

# App registration "System One API": Expose an API (App ID URI api://<client-id>, scope access_as_user),
# a client secret, API permissions: System Two -> access_as_user (delegated, admin-consented),
# and manifest "requestedAccessTokenVersion": 2 so tokens have the v2 issuer below.
S1_API_BASE_URL=http://localhost:8011
S1_API_CLIENT_ID=<system-one-api-client-id>
S1_API_CLIENT_SECRET=
S1_API_AUDIENCES=<system-one-api-client-id>,api://<system-one-api-client-id>
S1_API_REQUIRED_SCOPE=access_as_user

# App registration "System Two": Expose an API (scope access_as_user), manifest "requestedAccessTokenVersion": 2.
S2_BASE_URL=http://localhost:8002
S2_OBO_SCOPE=api://<system-two-client-id>/access_as_user
S2_AUDIENCES=<system-two-client-id>,api://<system-two-client-id>
S2_REQUIRED_SCOPE=access_as_user

# A dedicated test user with no MFA / Conditional Access prompts (needed for unattended Playwright runs).
E2E_USERNAME=<test-user>@<tenant>.onmicrosoft.com
E2E_PASSWORD=
